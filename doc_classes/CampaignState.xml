<?xml version="1.0" encoding="UTF-8"?>
<class name="CampaignState" inherits="Node">
	<brief_description>Persists cross-mission state.</brief_description>
	<description>Tracks faction relations, reputation, dead/injured agents, VIP outcomes, and district control across missions.</description>
	<methods>
		<method name="record_mission_outcome">
			<return type="void" />
			<param index="0" name="mission_id" type="int" />
			<param index="1" name="success" type="bool" />
			<param index="2" name="friendly_casualties" type="int" />
			<param index="3" name="enemy_casualties" type="int" />
		</method>
		<method name="record_agent_death">
			<return type="void" />
			<param index="0" name="id" type="int" />
		</method>
		<method name="record_agent_extraction">
			<return type="void" />
			<param index="0" name="id" type="int" />
		</method>
		<method name="is_agent_alive">
			<return type="bool" />
			<param index="0" name="id" type="int" />
		</method>
		<method name="get_alive_agent_count">
			<return type="int" />
		</method>
		<method name="set_district_control">
			<return type="void" />
			<param index="0" name="id" type="int" />
			<param index="1" name="faction" type="int" />
			<param index="2" name="stability" type="float" />
		</method>
		<method name="get_controlling_faction">
			<return type="int" />
			<param index="0" name="id" type="int" />
		</method>
		<method name="get_district_stability">
			<return type="float" />
			<param index="0" name="id" type="int" />
		</method>
		<method name="set_faction_reputation">
			<return type="void" />
			<param index="0" name="id" type="int" />
			<param index="1" name="rep" type="float" />
		</method>
		<method name="get_faction_reputation">
			<return type="float" />
			<param index="0" name="id" type="int" />
		</method>
		<method name="get_total_missions">
			<return type="int" />
		</method>
		<method name="get_successful_missions">
			<return type="int" />
		</method>
		<method name="get_success_rate">
			<return type="float" />
		</method>
	</methods>
</class>
